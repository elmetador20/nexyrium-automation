generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Conversation {
  id        String    @id @default(uuid())
  chatId    String    @unique @map("chat_id")
  phone     String    @map("phone")
  status    String    @default("ACTIVE") // ACTIVE, CLOSED, ARCHIVED
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  messages Message[]
  lead     Lead?

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  content        String   @db.Text
  direction      String   // INBOUND, OUTBOUND
  sender         String   @map("sender")
  chatId         String   @map("chat_id")
  timestamp      DateTime @map("timestamp")
  conversationId String   @map("conversation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([chatId])
  @@map("messages")
}

model Lead {
  id             String   @id @default(uuid())
  phoneNumber    String   @unique @map("phone_number")
  name           String?
  email          String?
  company        String?
  context        String?  @db.Text
  extractedData  String?  @map("extracted_data") @db.Text // AI-extracted structured data (JSON)
  source         String   @default("whatsapp")
  status         String   @default("NEW") // NEW, AI_PENDING, SYNC_PENDING, QUALIFIED, CONTACTED, CONVERTED, LOST
  retryCount     Int      @default(0) @map("retry_count")
  lastError      String?  @map("last_error") @db.Text
  conversationId String?  @unique @map("conversation_id")
  assignedSalesperson String? @map("assigned_salesperson")
  assignmentSyncPending Boolean @default(false) @map("assignment_sync_pending")
  assignmentError String? @map("assignment_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([status])
  @@index([assignmentSyncPending])
  @@map("leads")
}

model LeadAssignmentState {
  id String @id
  lastSalesperson String? @map("last_salesperson")

  @@map("lead_assignment_state")
}
