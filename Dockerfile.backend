FROM node:22-bookworm-slim AS base

# This image installs Chromium; application code does not assume its path.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium ca-certificates openssl fonts-liberation libxss1 passwd \
    && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY scripts/prisma-postinstall.js ./scripts/prisma-postinstall.js
# Native installs use the package postinstall hook. Docker runs the explicit
# generation below after dependencies and schema are present, without requiring
# DATABASE_URL during image construction.
ENV PRISMA_GENERATE_SKIP=1
RUN npm ci --omit=dev --include=optional
RUN npx prisma generate --schema=./prisma/schema.prisma
# Fail the image build rather than producing a runtime image that cannot load
# @prisma/client/default.js.
RUN test -f /app/node_modules/.prisma/client/default.js \
    && test -f /app/node_modules/.prisma/client/schema.prisma

FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
# Keep the generated runtime artifact explicit. The full node_modules copy above
# remains necessary for the other production dependencies.
COPY --from=deps /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=deps /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY package.json package-lock.json index.js prisma.config.ts ./
COPY prisma ./prisma
COPY src ./src
RUN test -f /app/node_modules/.prisma/client/default.js \
    && test -f /app/node_modules/.prisma/client/schema.prisma
RUN mkdir -p /app/.wwebjs_auth && chown -R node:node /app
# Render mounts Docker Secret Files at /etc/secrets with group-1000 access.
# Keep the non-root runtime user while allowing it to read credentials.json.
RUN usermod -a -G 1000 node
USER node
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||10000)+'/health',{signal:AbortSignal.timeout(5000)}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["npm", "start"]
