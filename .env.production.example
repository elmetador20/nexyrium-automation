# Render backend configuration. Supply real values in Render, never in Git.
NODE_ENV=production
PORT=10000
DATABASE_URL="mysql://lead_user:URL_ENCODED_PASSWORD@mysql.example.com:3306/nexyrium"

# External MongoDB stores the supported RemoteAuth GridFS backup.
WHATSAPP_MONGODB_URI="mongodb+srv://wa_user:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/whatsapp_auth?retryWrites=true&w=majority"
WHATSAPP_CLIENT_ID=nexyrium
WHATSAPP_SESSION_DATA_PATH=/app/.wwebjs_auth
WHATSAPP_BACKUP_INTERVAL_MS=300000
ADMIN_API_TOKEN="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

OPENROUTER_API_KEY="REPLACE_WITH_OPENROUTER_KEY"
OPENROUTER_MODEL=openai/gpt-3.5-turbo
GOOGLE_SHEETS_SPREADSHEET_ID="REPLACE_WITH_SPREADSHEET_ID"
GOOGLE_SHEETS_CREDENTIALS_PATH=/etc/secrets/credentials.json
CRON_SCHEDULE="*/5 * * * *"
MAX_RETRIES=5
RETRY_DELAY_MS=5000
LOG_LEVEL=info

# Docker sets this automatically because it installs system Chromium.
# Leave unset locally to use Puppeteer's downloaded browser.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Existing dashboard fetches append /api/... themselves. Do not add /api here.
NEXT_PUBLIC_API_URL=https://nexyrium-backend.onrender.com
